# Base de dados PostgreSQL
DATABASE_URL=postgresql://gasja:gasja@localhost:5432/gasja

# Segredo para assinar os tokens de sessão (gerar um valor longo e aleatório em produção)
JWT_SECRET=mudar-isto

# Segredo partilhado com os fornecedores (agregador de SMS, PBX, gateway de pagamento),
# enviado no cabeçalho x-gasja-segredo dos webhooks
CANAIS_SEGREDO_WEBHOOK=mudar-isto

PORT=3000

# Conta de administrador criada pelo seed (obrigatório em produção; em desenvolvimento
# usa admin@gasja.ao / gasja-admin-dev)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Só para os testes e2e: base de dados própria
# DATABASE_URL_TESTE=postgresql://gasja:gasja@localhost:5432/gasja_teste
